# 复制为 .env 后再启动。不要提交真实密钥。
# 容器里的 API 由 docker-compose 固定连 mysql / redis 服务名。
# 只有在宿主机用 nvm 跑 API、数据库仍在 Docker 里时，才使用下面这两条 127.0.0.1 地址，
# 并执行 docker compose stop api，避免和容器抢 3000 端口。

NODE_ENV=development
PORT=3000

DATABASE_URL=mysql://aurel:aurel_dev_password@127.0.0.1:3306/aurel_mall
REDIS_URL=redis://127.0.0.1:6379

# 生产必须保持 false。只有测试环境才设为 true。
ALLOW_CLOCK_OVERRIDE=false

JWT_ADMIN_SECRET=dev-admin-jwt-placeholder
MINI_PROGRAM_TOKEN_SECRET=dev-mini-program-placeholder

MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_DATABASE=aurel_mall
MYSQL_USER=aurel
MYSQL_PASSWORD=aurel_dev_password

# ---------------------------------------------------------------------------
# 需求 §1.1 锁定配置。进程启动时读取，管理端不能修改，改完必须重启。
# 金额单位：分（1 元 = 100 分）。比例单位：万分比（10000 = 100%）。
# 除红包门槛 K、上限 C 的示例来自需求外，其余数字都是占位示例，不是已确认的产品规则。
# 钱包拆分目标：withdrawable 可提现余额 + points 积分，两项必须合计 10000。
# ---------------------------------------------------------------------------

# 创业专区单价 N。示例 100000 分 = 1000.00 元。
STARTUP_ZONE_UNIT_PRICE_FEN=100000

# 报单/结算可提现比例。示例 8000 = 80%。
FILING_WITHDRAWAL_RATIO_BPS=8000

# 创业专区销售奖比例 R，以及钱包拆分。示例 R=10%，70% 可提现 / 30% 积分。
STARTUP_SALES_AWARD_RATIO_BPS=1000
STARTUP_SALES_AWARD_WITHDRAWABLE_BPS=7000
STARTUP_SALES_AWARD_POINTS_BPS=3000

# 创业专区积分奖比例 P。示例 P=5%，全部进积分。
STARTUP_POINT_AWARD_RATIO_BPS=500
STARTUP_POINT_AWARD_WITHDRAWABLE_BPS=0
STARTUP_POINT_AWARD_POINTS_BPS=10000

# 商城销售奖比例 S。示例 S=8%，70% 可提现 / 30% 积分。
MALL_SALES_AWARD_RATIO_BPS=800
MALL_SALES_AWARD_WITHDRAWABLE_BPS=7000
MALL_SALES_AWARD_POINTS_BPS=3000

# 商城积分奖比例 Q。示例 Q=3%，全部进积分。
MALL_POINT_AWARD_RATIO_BPS=300
MALL_POINT_AWARD_WITHDRAWABLE_BPS=0
MALL_POINT_AWARD_POINTS_BPS=10000

# 职位分红份额档位，格式 code:shares，多项用逗号分隔。示例档位，正式职位名待确认。
POSITION_DIVIDEND_SHARE_TIERS=leader:1,manager:2,director:3

# 每日红包计提 = 当日创业专区销售额 × 该万分比。示例 100 = 1%。
RED_PACKET_DAILY_ACCRUAL_BPS=100

# 红包轮次实付门槛 K。需求示例 5000 元 = 500000 分。
RED_PACKET_ROUND_PAY_THRESHOLD_FEN=500000

# 每轮领取上限 C。需求示例 8000 元 = 800000 分。
RED_PACKET_ROUND_CLAIM_CAP_FEN=800000

# 联合创始人 / 工作室 / 运营团队分红比例。示例，计算基数尚未实现。
COFOUNDER_DIVIDEND_RATIO_BPS=3000
STUDIO_DIVIDEND_RATIO_BPS=2000
OPERATIONS_TEAM_DIVIDEND_RATIO_BPS=1000

# 营销经理市场门槛 T。这不是锁定项。
# 只在 admin_settings 还没有该键时，作为首次写入的默认值；之后以数据库为准，管理端可改。
# 单位与正式数值待产品确认。示例 10000。
MARKETING_MANAGER_MARKET_THRESHOLD_DEFAULT=10000
