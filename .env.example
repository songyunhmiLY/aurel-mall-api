# 复制为 .env 后再启动。不要提交真实密钥。
# 容器里的 API 由 docker-compose 固定连 mysql / redis 服务名。
# 只有在宿主机用 nvm 跑 API、数据库仍在 Docker 里时，才使用下面这两条 127.0.0.1 地址，
# 并执行 docker compose stop api，避免和容器抢 3000 端口。

NODE_ENV=development
PORT=3000

DATABASE_URL=mysql://aurel:aurel_dev_password@127.0.0.1:3306/aurel_mall
REDIS_URL=redis://127.0.0.1:6379

# 生产必须保持 false。只有测试环境才设为 true。
ALLOW_CLOCK_OVERRIDE=false

# 开发预览登录。默认关闭。关闭时预览登录一律 403，不看主机名或来源 IP。
# 打开后，uni-app H5 预览可以用 POST /api/v1/auth/preview/login 切换测试身份。
# 这不是正式 H5 登录，也不走微信网站应用 OAuth。
ALLOW_PREVIEW_AUTH=false

JWT_ADMIN_SECRET=dev-admin-jwt-placeholder
MINI_PROGRAM_TOKEN_SECRET=dev-mini-program-placeholder

# 微信小程序登录。正式环境填写该小程序的 AppId 和 AppSecret。留空则小程序登录不可用。
# 不要把生产密钥提交到仓库。
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=

# 首次启动时，若该用户名还不存在，则创建一名管理员。已存在则不会改密码。
# 两者都留空则不自动创建。不要把生产密码提交到仓库。
# 再添加管理员：改成新的用户名和密码后重启，旧账户保留。权限与已有管理员相同。
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_DISPLAY_NAME=

# 微信支付回调地址。商户号、证书、APIv3 密钥未配齐时可以留空。
# 例：https://api.example.com/api/v1/payments/wechat/notify
WECHAT_PAY_NOTIFY_URL=

MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_DATABASE=aurel_mall
MYSQL_USER=aurel
MYSQL_PASSWORD=aurel_dev_password

# ---------------------------------------------------------------------------
# 需求 §1.1 锁定配置。进程启动时读取，管理端不能修改，改完必须重启。
# 金额单位：分（1 元 = 100 分）。比例单位：万分比（10000 = 100%）。
# 报单、创业奖、商城奖、职位池、每日报单检查时间和福利专场奖池用下面的示例。提现手续费仍是占位。
# 创业奖拆分、商城奖拆分各自三项（可提现 + 积分 + 消费）必须合计 10000。
# 每日报单检查时间不是管理端配置。
# ---------------------------------------------------------------------------

# 创业专区单价 N。示例 100000 分 = 1000.00 元。
STARTUP_ZONE_UNIT_PRICE_FEN=100000

# 报单结算：积分入账 N，可提现入账 N × 该比例。示例 2000 = 20%。
FILING_WITHDRAWAL_RATIO_BPS=2000

# 每日报单检查的上海时间，HH:mm。示例 00:01。进程启动时读一次。
FILING_DAILY_CHECK_TIME=00:01

# 创业专区销售奖比例 R、见点奖比例 P。示例 R=5%，P=2%。
# 两笔奖励共用下面的创业奖拆分。示例 85% 可提现 / 5% 积分 / 10% 消费。
STARTUP_SALES_AWARD_RATIO_BPS=500
STARTUP_POINT_AWARD_RATIO_BPS=200
STARTUP_AWARD_WITHDRAWABLE_BPS=8500
STARTUP_AWARD_POINTS_BPS=500
STARTUP_AWARD_CONSUMPTION_BPS=1000

# 商城销售奖比例 S、见点奖比例 Q。示例 S=5%，Q=2%。
# 商城两笔奖励和职位分红共用下面的商城拆分。示例 85% 可提现 / 10% 积分 / 5% 消费。
MALL_SALES_AWARD_RATIO_BPS=500
MALL_POINT_AWARD_RATIO_BPS=200
MALL_AWARD_WITHDRAWABLE_BPS=8500
MALL_AWARD_POINTS_BPS=1000
MALL_AWARD_CONSUMPTION_BPS=500

# 职位分红池，从低到高，格式 code:bps。第一档不与更高职位叠加。
# 示例：营销经理 8%、高级经理 6%、营销总监 5%、高级总监 4%、首席 3%。
POSITION_DIVIDEND_POOL_BPS=marketing_manager:800,senior_manager:600,director:500,senior_director:400,chief:300

# 福利专场当日奖池占当日创业专区商品金额的万分比。需求示例 3% = 300。不是管理端配置。
RED_PACKET_DAILY_ACCRUAL_BPS=300

# 红包轮次实付门槛 K。需求示例 5000 元 = 500000 分。
RED_PACKET_ROUND_PAY_THRESHOLD_FEN=500000

# 每轮领取上限 C。需求示例 8000 元 = 800000 分。
RED_PACKET_ROUND_CLAIM_CAP_FEN=800000

# 联合创始人分红。官方示例两条都是 2% = 200。未单独设置时创业专区和商城都用这一条。
# 原先示例 3000 只是未结算前的占位，现在会入账，示例改为 200。正式比例仍以部署环境为准。
COFOUNDER_DIVIDEND_RATIO_BPS=200
# 可选。留空则等于 COFOUNDER_DIVIDEND_RATIO_BPS。
# COFOUNDER_STARTUP_DIVIDEND_RATIO_BPS=200
# COFOUNDER_MALL_DIVIDEND_RATIO_BPS=200
STUDIO_DIVIDEND_RATIO_BPS=2000
OPERATIONS_TEAM_DIVIDEND_RATIO_BPS=1000

# 提现手续费，单位分。打款时从申请金额中减去当时的值。不是管理端可改项。
# 正式金额未在需求清单中给出，示例 0。
WITHDRAWAL_FEE_FEN=0

# 营销经理市场门槛 T。这不是锁定项。单位是分。
# 只在还没有任何生效月份时，作为当前月的首次默认值；之后以数据库为准。
# 管理端修改只从下一个自然月生效。示例 2000000 分 = 20000.00 元。
MARKETING_MANAGER_MARKET_THRESHOLD_DEFAULT=2000000
