erDiagram
  users ||--o{ user_identities : "user_id"
  users ||--o| user_kyc : "user_id"
  users ||--o{ user_addresses : "user_id"
  admin_users |o--o{ admin_settings : "updated_by_admin_id"

  users {
    bigint id PK
    varchar status
    varchar nickname
    varchar phone
    varchar invite_code UK
    datetime created_at
    datetime updated_at
  }
  user_identities {
    bigint id PK
    bigint user_id
    varchar provider
    varchar identifier UK
    varchar union_id
  }
  user_kyc {
    bigint id PK
    bigint user_id UK
    varchar real_name
    char id_number
    varchar mobile
    varchar status
  }
  user_addresses {
    bigint id PK
    bigint user_id
    varchar contact_name
    boolean is_default
  }
  admin_users {
    bigint id PK
    varchar username UK
    varchar password_hash
    varchar status
  }
  admin_settings {
    bigint id PK
    varchar setting_key UK
    text setting_value
    bigint updated_by_admin_id
  }
