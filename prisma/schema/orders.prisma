/// status: pending_payment / paid / closed。zone 与商品专区编码一致。时间由应用写入。
model Order {
  id            BigInt    @id @default(autoincrement())
  orderNo       String    @unique(map: "orders_order_no_uq") @map("order_no") @db.VarChar(32)
  userId        BigInt    @map("user_id")
  zone          String    @db.VarChar(32)
  status        String    @db.VarChar(32)
  goodsTotalFen Int       @map("goods_total_fen")
  payAmountFen  Int       @map("pay_amount_fen")
  placedAt      DateTime  @map("placed_at") @db.DateTime(3)
  paidAt        DateTime? @map("paid_at") @db.DateTime(3)
  closedAt      DateTime? @map("closed_at") @db.DateTime(3)
  createdAt     DateTime  @map("created_at") @db.DateTime(3)
  updatedAt     DateTime  @map("updated_at") @db.DateTime(3)

  @@index([userId, placedAt], map: "orders_user_id_placed_at_idx")
  @@index([status], map: "orders_status_idx")
  @@map("orders")
}

model OrderItem {
  id           BigInt   @id @default(autoincrement())
  orderId      BigInt   @map("order_id")
  skuId        BigInt   @map("sku_id")
  productName  String   @map("product_name") @db.VarChar(128)
  skuName      String   @map("sku_name") @db.VarChar(128)
  unitPriceFen Int      @map("unit_price_fen")
  quantity     Int
  lineTotalFen Int      @map("line_total_fen")
  createdAt    DateTime @map("created_at") @db.DateTime(3)

  @@index([orderId], map: "order_items_order_id_idx")
  @@index([skuId], map: "order_items_sku_id_idx")
  @@map("order_items")
}

/// channel: wechat。status: pending / success / failed。时间由应用写入。
/// active_slot 在待支付时为 order:{orderId}，终态清空，保证同一订单同时只有一笔待支付。
model Payment {
  id             BigInt    @id @default(autoincrement())
  orderId        BigInt    @map("order_id")
  payNo          String    @unique(map: "payments_pay_no_uq") @map("pay_no") @db.VarChar(64)
  channel        String    @db.VarChar(32)
  amountFen      Int       @map("amount_fen")
  status         String    @db.VarChar(32)
  channelTradeNo String?   @unique(map: "payments_channel_trade_no_uq") @map("channel_trade_no") @db.VarChar(64)
  prepayId       String?   @map("prepay_id") @db.VarChar(64)
  activeSlot     String?   @unique(map: "payments_active_slot_uq") @map("active_slot") @db.VarChar(64)
  succeededAt    DateTime? @map("succeeded_at") @db.DateTime(3)
  createdAt      DateTime  @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @map("updated_at") @db.DateTime(3)

  @@index([orderId], map: "payments_order_id_idx")
  @@index([status], map: "payments_status_idx")
  @@map("payments")
}
