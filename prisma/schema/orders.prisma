/// status: pending_payment / paid / shipped / closed。zone 与商品专区编码一致。
/// 金额单位为分。账户拆分在发起支付时写入；未拆分前四个来源都是 0。
/// 收货信息是下单时的地址快照。时间由应用写入。
model Order {
  id               BigInt    @id @default(autoincrement())
  orderNo          String    @unique(map: "orders_order_no_uq") @map("order_no") @db.VarChar(32)
  userId           BigInt    @map("user_id")
  zone             String    @db.VarChar(32)
  status           String    @db.VarChar(32)
  goodsTotalFen    Int       @map("goods_total_fen")
  freightFen       Int       @map("freight_fen")
  payAmountFen     Int       @map("pay_amount_fen")
  /// 订单 PV，商城为各行单价 PV × 数量之和。创业专区为 0。不是售价。
  pvFen            Int       @map("pv_fen")
  pointsFen        Int       @map("points_fen")
  withdrawableFen  Int       @map("withdrawable_fen")
  consumptionFen   Int       @map("consumption_fen")
  wechatFen        Int       @map("wechat_fen")
  contactName      String    @map("contact_name") @db.VarChar(64)
  contactPhone     String    @map("contact_phone") @db.VarChar(32)
  province         String    @db.VarChar(32)
  city             String    @db.VarChar(32)
  district         String    @db.VarChar(32)
  detail           String    @db.VarChar(255)
  courierName      String?   @map("courier_name") @db.VarChar(64)
  trackingNo       String?   @map("tracking_no") @db.VarChar(64)
  placedAt         DateTime  @map("placed_at") @db.DateTime(3)
  paidAt           DateTime? @map("paid_at") @db.DateTime(3)
  shippedAt        DateTime? @map("shipped_at") @db.DateTime(3)
  closedAt         DateTime? @map("closed_at") @db.DateTime(3)
  createdAt        DateTime  @map("created_at") @db.DateTime(3)
  updatedAt        DateTime  @map("updated_at") @db.DateTime(3)

  @@index([userId, placedAt], map: "orders_user_id_placed_at_idx")
  @@index([status], map: "orders_status_idx")
  @@index([zone, status], map: "orders_zone_status_idx")
  @@map("orders")
}

model OrderItem {
  id           BigInt   @id @default(autoincrement())
  orderId      BigInt   @map("order_id")
  skuId        BigInt   @map("sku_id")
  productName  String   @map("product_name") @db.VarChar(128)
  skuName      String   @map("sku_name") @db.VarChar(128)
  unitPriceFen Int      @map("unit_price_fen")
  /// 单价 PV。创业专区为 0。行 PV = pv_fen × quantity。
  pvFen        Int      @map("pv_fen")
  /// 商品运费单价。行运费 = freight_fen × quantity。
  freightFen   Int      @map("freight_fen")
  quantity     Int
  lineTotalFen Int      @map("line_total_fen")
  createdAt    DateTime @map("created_at") @db.DateTime(3)

  @@index([orderId], map: "order_items_order_id_idx")
  @@index([skuId], map: "order_items_sku_id_idx")
  @@map("order_items")
}

/// channel: wechat。status: pending / success / failed。时间由应用写入。
/// purpose: order 商品订单 / cofounder_activation 联合创始人开通。开通单没有订单。
/// active_slot 在待支付时为 order:{orderId} 或 cofounder:{userId}，终态清空。
model Payment {
  id             BigInt    @id @default(autoincrement())
  orderId        BigInt?   @map("order_id")
  /// order / cofounder_activation。旧行默认 order。
  purpose        String    @default("order") @db.VarChar(32)
  /// 联合创始人开通的付款人。商品订单仍以 orders.user_id 为准，这里可空。
  userId         BigInt?   @map("user_id")
  payNo          String    @unique(map: "payments_pay_no_uq") @map("pay_no") @db.VarChar(64)
  channel        String    @db.VarChar(32)
  amountFen      Int       @map("amount_fen")
  status         String    @db.VarChar(32)
  channelTradeNo String?   @unique(map: "payments_channel_trade_no_uq") @map("channel_trade_no") @db.VarChar(64)
  prepayId       String?   @map("prepay_id") @db.VarChar(64)
  activeSlot     String?   @unique(map: "payments_active_slot_uq") @map("active_slot") @db.VarChar(64)
  succeededAt    DateTime? @map("succeeded_at") @db.DateTime(3)
  createdAt      DateTime  @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @map("updated_at") @db.DateTime(3)

  @@index([orderId], map: "payments_order_id_idx")
  @@index([status], map: "payments_status_idx")
  @@index([userId, purpose, status], map: "payments_user_purpose_status_idx")
  @@map("payments")
}

/// status: pending / approved / rejected。
/// 申请时不写退款金额和减扣金额。审核通过时两者补齐，且之和等于订单应付。
/// 创业专区订单不能写入通过状态。已发奖励不在这张表回滚。
model OrderRefund {
  id                       BigInt    @id @default(autoincrement())
  orderId                  BigInt    @map("order_id")
  userId                   BigInt    @map("user_id")
  status                   String    @db.VarChar(32)
  payAmountFen             Int       @map("pay_amount_fen")
  freightFen               Int       @map("freight_fen")
  refundFen                Int?      @map("refund_fen")
  deductionFen             Int?      @map("deduction_fen")
  wechatRefundFen          Int?      @map("wechat_refund_fen")
  withdrawableDeductionFen Int?      @map("withdrawable_deduction_fen")
  consumptionCreditFen     Int?      @map("consumption_credit_fen")
  /// none / sandbox / accepted。没有商户资料时记 sandbox，不调用微信。
  wechatRefundStatus       String?   @map("wechat_refund_status") @db.VarChar(32)
  wechatRefundNo           String?   @unique(map: "order_refunds_wechat_refund_no_uq") @map("wechat_refund_no") @db.VarChar(64)
  appliedAt                DateTime  @map("applied_at") @db.DateTime(3)
  decidedAt                DateTime? @map("decided_at") @db.DateTime(3)
  decidedByAdminId         BigInt?   @map("decided_by_admin_id")
  createdAt                DateTime  @map("created_at") @db.DateTime(3)
  updatedAt                DateTime  @map("updated_at") @db.DateTime(3)

  @@index([userId, status], map: "order_refunds_user_status_idx")
  @@index([orderId, status], map: "order_refunds_order_status_idx")
  @@index([status, appliedAt], map: "order_refunds_status_applied_idx")
  @@map("order_refunds")
}
