/// walletType: withdrawable 可提现余额 / points 积分。余额单位为分。
model WalletAccount {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  walletType String   @map("wallet_type") @db.VarChar(32)
  balanceFen BigInt   @map("balance_fen")
  updatedAt  DateTime @map("updated_at") @db.DateTime(3)

  @@unique([userId, walletType], map: "wallet_accounts_user_type_uq")
  @@map("wallet_accounts")
}

/// direction: credit / debit。occurredAt 是业务发生时间，由 ClockService 写入。
model WalletLedgerEntry {
  id              BigInt   @id @default(autoincrement())
  accountId       BigInt   @map("account_id")
  userId          BigInt   @map("user_id")
  walletType      String   @map("wallet_type") @db.VarChar(32)
  direction       String   @db.VarChar(16)
  amountFen       BigInt   @map("amount_fen")
  balanceAfterFen BigInt   @map("balance_after_fen")
  bizType         String   @map("biz_type") @db.VarChar(64)
  bizId           String   @map("biz_id") @db.VarChar(64)
  occurredAt      DateTime @map("occurred_at") @db.DateTime(3)
  createdAt       DateTime @map("created_at") @db.DateTime(3)

  @@index([accountId, occurredAt], map: "wallet_ledger_account_occurred_idx")
  @@index([userId, occurredAt], map: "wallet_ledger_user_occurred_idx")
  @@index([bizType, bizId], map: "wallet_ledger_biz_idx")
  @@map("wallet_ledger_entries")
}
