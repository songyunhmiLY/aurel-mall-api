/// status: draft / on / off。
/// linkUrl 存点击后打开的小程序页面路径，不是网页地址。
model Banner {
  id        BigInt   @id @default(autoincrement())
  title     String   @db.VarChar(128)
  imageUrl  String   @map("image_url") @db.VarChar(512)
  linkUrl   String?  @map("link_url") @db.VarChar(512)
  sortOrder Int      @map("sort_order")
  status    String   @db.VarChar(32)
  createdAt DateTime @map("created_at") @db.DateTime(3)
  updatedAt DateTime @map("updated_at") @db.DateTime(3)

  @@index([status, sortOrder], map: "banners_status_sort_idx")
  @@map("banners")
}

/// kind: article 文章 / news 新闻 / notice 通知。
/// status: draft / published / off。publishedAt 由应用在发布时写入。
model Article {
  id          BigInt    @id @default(autoincrement())
  kind        String    @db.VarChar(32)
  title       String    @db.VarChar(200)
  summary     String    @db.VarChar(500)
  body        String    @db.MediumText
  coverUrl    String?   @map("cover_url") @db.VarChar(512)
  status      String    @db.VarChar(32)
  publishedAt DateTime? @map("published_at") @db.DateTime(3)
  createdAt   DateTime  @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @map("updated_at") @db.DateTime(3)

  @@index([status, publishedAt], map: "articles_status_published_idx")
  @@index([kind, status, publishedAt], map: "articles_kind_status_published_idx")
  @@map("articles")
}

/// status: draft / on / off。
model Ticker {
  id        BigInt   @id @default(autoincrement())
  content   String   @db.VarChar(255)
  sortOrder Int      @map("sort_order")
  status    String   @db.VarChar(32)
  createdAt DateTime @map("created_at") @db.DateTime(3)
  updatedAt DateTime @map("updated_at") @db.DateTime(3)

  @@index([status, sortOrder], map: "tickers_status_sort_idx")
  @@map("tickers")
}

/// 资讯和知识富文本里的插图。原图字节存 data，公开只读接口按 id 供图。
model CmsImage {
  id        BigInt   @id @default(autoincrement())
  mime      String   @db.VarChar(64)
  sizeBytes Int      @map("size_bytes")
  data      Bytes    @db.LongBlob
  createdAt DateTime @map("created_at") @db.DateTime(3)

  @@map("cms_images")
}
