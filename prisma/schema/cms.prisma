/// status: draft / on / off。
model Banner {
  id        BigInt   @id @default(autoincrement())
  title     String   @db.VarChar(128)
  imageUrl  String   @map("image_url") @db.VarChar(512)
  linkUrl   String?  @map("link_url") @db.VarChar(512)
  sortOrder Int      @map("sort_order")
  status    String   @db.VarChar(32)
  createdAt DateTime @map("created_at") @db.DateTime(3)
  updatedAt DateTime @map("updated_at") @db.DateTime(3)

  @@index([status, sortOrder], map: "banners_status_sort_idx")
  @@map("banners")
}

/// status: draft / published / off。publishedAt 由应用写入。
model Article {
  id          BigInt    @id @default(autoincrement())
  title       String    @db.VarChar(200)
  summary     String    @db.VarChar(500)
  body        String    @db.Text
  coverUrl    String?   @map("cover_url") @db.VarChar(512)
  status      String    @db.VarChar(32)
  publishedAt DateTime? @map("published_at") @db.DateTime(3)
  createdAt   DateTime  @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @map("updated_at") @db.DateTime(3)

  @@index([status, publishedAt], map: "articles_status_published_idx")
  @@map("articles")
}

model Ticker {
  id        BigInt   @id @default(autoincrement())
  content   String   @db.VarChar(255)
  sortOrder Int      @map("sort_order")
  status    String   @db.VarChar(32)
  createdAt DateTime @map("created_at") @db.DateTime(3)
  updatedAt DateTime @map("updated_at") @db.DateTime(3)

  @@index([status, sortOrder], map: "tickers_status_sort_idx")
  @@map("tickers")
}
