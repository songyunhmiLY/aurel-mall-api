/// 仅存放管理员可改的配置。锁定项不写入本表。
/// 值用 TEXT，以便保存微信支付 API 证书。
/// 营销经理门槛 T 的生效月份在 market_threshold_revisions。
/// 本表仍可能留着旧键 marketing_manager_market_threshold，只作为首次迁移来源。
/// 微信支付键：wechat_pay_mch_id、wechat_pay_api_certificate、wechat_pay_api_v3_key。
/// 消息推送键：notify_delivery_mode、notify_sms_*、notify_evt_{event}_{enabled|wx_tpl|sms_tpl|page|slots}。
model AdminSetting {
  id               BigInt   @id @default(autoincrement())
  settingKey       String   @unique(map: "admin_settings_setting_key_uq") @map("setting_key") @db.VarChar(64)
  settingValue     String   @map("setting_value") @db.MediumText
  updatedAt        DateTime @map("updated_at") @db.DateTime(3)
  updatedByAdminId BigInt?  @map("updated_by_admin_id")

  @@map("admin_settings")
}

/// 营销经理门槛 T，单位分。某月采用 effectiveMonth 小于等于该月的最新一行。
/// 管理端修改只写入下一个自然月，不改当月。
model MarketThresholdRevision {
  id               BigInt   @id @default(autoincrement())
  effectiveMonth   String   @unique(map: "market_threshold_revisions_month_uq") @map("effective_month") @db.Char(7)
  thresholdFen     BigInt   @map("threshold_fen")
  updatedByAdminId BigInt?  @map("updated_by_admin_id")
  createdAt        DateTime @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @map("updated_at") @db.DateTime(3)

  @@map("market_threshold_revisions")
}

/// 业绩月份的职位分红。payoutDate 是次月的发放日，默认 15 日。status: open / paid。
model PositionDividendPeriod {
  id               BigInt    @id @default(autoincrement())
  performanceMonth String    @unique(map: "position_dividend_periods_month_uq") @map("performance_month") @db.Char(7)
  payoutDate       String    @map("payout_date") @db.Char(10)
  status           String    @db.VarChar(32)
  mallPvFen        BigInt?   @map("mall_pv_fen")
  autoPaidAt       DateTime? @map("auto_paid_at") @db.DateTime(3)
  createdAt        DateTime  @map("created_at") @db.DateTime(3)
  updatedAt        DateTime  @map("updated_at") @db.DateTime(3)

  @@map("position_dividend_periods")
}

/// 从自动发放中移除的会员。只移除此人，不取消整个周期，份额不重分。
model PositionDividendExclusion {
  id               BigInt   @id @default(autoincrement())
  periodId         BigInt   @map("period_id")
  userId           BigInt   @map("user_id")
  removedByAdminId BigInt   @map("removed_by_admin_id")
  removedAt        DateTime @map("removed_at") @db.DateTime(3)
  createdAt        DateTime @map("created_at") @db.DateTime(3)

  @@unique([periodId, userId], map: "position_dividend_exclusions_period_user_uq")
  @@index([userId], map: "position_dividend_exclusions_user_idx")
  @@map("position_dividend_exclusions")
}

/// 自动发放和手工发放记在一起。mode: auto / manual。
/// 同一周期、同一会员、同一职位最多一行。手工行必须有备注、原计算额和实发额。
model PositionDividendRecord {
  id                BigInt   @id @default(autoincrement())
  periodId          BigInt   @map("period_id")
  userId            BigInt   @map("user_id")
  positionCode      String   @map("position_code") @db.VarChar(32)
  mode              String   @db.VarChar(16)
  originalAmountFen BigInt   @map("original_amount_fen")
  actualAmountFen   BigInt   @map("actual_amount_fen")
  remark            String?  @db.VarChar(200)
  adminId           BigInt?  @map("admin_id")
  paidAt            DateTime @map("paid_at") @db.DateTime(3)
  createdAt         DateTime @map("created_at") @db.DateTime(3)

  @@unique([periodId, userId, positionCode], map: "position_dividend_records_slot_uq")
  @@index([periodId, paidAt], map: "position_dividend_records_period_paid_idx")
  @@map("position_dividend_records")
}
